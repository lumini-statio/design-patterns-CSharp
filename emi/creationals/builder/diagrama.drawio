                <mxCell id="9fJzgJktsK_w-wZnPlqi-37" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;builder.reset();&lt;/span&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(118, 96, 164, 0.35) rgb(16, 13, 17);&quot;&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(118, 96, 164, 0.35) rgb(16, 13, 17);&quot;&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(118, 96, 164, 0.35) rgb(16, 13, 17);&quot;&gt;if (type == MUZZARELLA) {&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(118, 96, 164, 0.35) rgb(16, 13, 17);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;builder.buildSize(LARGE);&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(118, 96, 164, 0.35) rgb(16, 13, 17);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;builder.buildDoughType(StoneBaked);&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(118, 96, 164, 0.35) rgb(16, 13, 17);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;builder.addIngredient(OLIVES);&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(118, 96, 164, 0.35) rgb(16, 13, 17);&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(118, 96, 164, 0.35) rgb(16, 13, 17);&quot;&gt;} else if (type == NAPOLITANA) {&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(118, 96, 164, 0.35) rgb(16, 13, 17);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;builder.buildSize(MEDIUM);&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(118, 96, 164, 0.35) rgb(16, 13, 17);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;builder.&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;buildDoughType&lt;/span&gt;(ThinCrust);&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(118, 96, 164, 0.35) rgb(16, 13, 17);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;builder.addIngredient(TOMATO);&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(118, 96, 164, 0.35) rgb(16, 13, 17);&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;builder.addIngredient(GARLIC);&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgba(118, 96, 164, 0.35) rgb(16, 13, 17);&quot;&gt;}&lt;/div&gt;" vertex="1">
